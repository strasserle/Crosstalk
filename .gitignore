# =====================================================================
# integration_gene_regulation
#
# Allowlist: everything is excluded, then the files that ship are named
# explicitly. The repository holds the scripts that produce the final
# output, the README, and the small tables those scripts need or
# summarise. Nothing else -- the working tree is ~35 GB.
#
# Adding a file to the repo means adding a `!` line here.
# =====================================================================

# --------------------------------------------------- exclude everything
/*

# ------------------------------------------------------- repo root keep
!/.gitignore
!/README.md
!/requirements.txt
!/environment.yml
# miRNA ID map, read by s02a_build_canonical_candidates.R
!/mirna_mapping.csv
!/coreg_pipeline

# ------------------------------------------- pipeline: scripts that ship
coreg_pipeline/*

# shared modules
!coreg_pipeline/provenance.py
!coreg_pipeline/grnboost_local.py

# stages 00-05, main tree (writes results/)
!coreg_pipeline/s00_reference.py
!coreg_pipeline/s01_expression.py
!coreg_pipeline/s02_layer1.py
!coreg_pipeline/s03_layer2.py
!coreg_pipeline/run_s03.sh
!coreg_pipeline/run_s03_tumour.sh
!coreg_pipeline/s04_network.py
!coreg_pipeline/s05_effects.py

# canonical-pool rebuild (writes results_canonical/, read by the figures)
!coreg_pipeline/s02a_build_canonical_candidates.R
!coreg_pipeline/s02_layer1_canonical.py
!coreg_pipeline/s04_network_canonical.py

# figures: only the scripts that produce the poster panels
!coreg_pipeline/sX_make_figures.py
!coreg_pipeline/sX_make_poster_findings.py

# cohort list read by run_s03_tumour.sh
!coreg_pipeline/nets_tumour.txt

# Precomputed input to the figure scripts, with no producing script in the repo.
# (manifest.json is deliberately NOT tracked: it is a per-run provenance log,
#  regenerated by provenance.py on every stage)
!coreg_pipeline/network_summary_23cohorts.tsv

# ------------------------------------- reference lists (3 small tables)
!coreg_pipeline/data
coreg_pipeline/data/*
!coreg_pipeline/data/reference
coreg_pipeline/data/reference/*
!coreg_pipeline/data/reference/tf_list.tsv
!coreg_pipeline/data/reference/tf_signs.tsv
!coreg_pipeline/data/reference/mirna_loci.tsv

# ------------- canonical Jaccard matrices read by the poster figure functions
# Only these three; they have no producing script in the repo, so without them
# the cross-cancer panels cannot be redrawn. Everything else under
# results_canonical/ stays out (including the 93 MB candidate pool).
!coreg_pipeline/results_canonical
coreg_pipeline/results_canonical/*
!coreg_pipeline/results_canonical/l1_jaccard_matrix_23cohorts.tsv
!coreg_pipeline/results_canonical/l1_jaccard_matrix_22cohorts.tsv
!coreg_pipeline/results_canonical/complete_network_jaccard_matrix_23cohorts.tsv
